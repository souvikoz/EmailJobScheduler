# Server & Security
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# REQUIRED: 32+ character random secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler

# Redis (used by BullMQ and atomic rate limiter)
REDIS_URL=redis://127.0.0.1:6379

# Elasticsearch
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Scheduler, Concurrency & Rate Limiting (no hardcoding!)
RUN_EMBEDDED_WORKER=true
GUEST_LOGIN_ENABLED=true
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR_GLOBAL=200
EMAIL_JOB_MAX_ATTEMPTS=3

# Google OAuth 2.0 (Google Cloud Console -> Web Application OAuth Client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth 2.0 (api.slack.com/apps -> OAuth & Permissions)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback

# Optional default Ethereal SMTP sender (auto-provisioned per user on demand via Ethereal API as well)
DEFAULT_ETHEREAL_HOST=smtp.ethereal.email
DEFAULT_ETHEREAL_PORT=587
DEFAULT_ETHEREAL_USER=
DEFAULT_ETHEREAL_PASS=
